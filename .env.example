PROJECT_NAME="Dhaga & Co - Intelligent Returns Triage Engine"
API_V1_STR="/api/v1"
DEBUG=False

# OpenRouter LLM Configuration
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Model 1 (Bulk Triage & Extraction, T=0.0)
# OpenRouter format: provider/model-name (e.g. openai/gpt-4o-mini, google/gemini-flash-1.5, meta-llama/llama-3.1-8b-instruct)
MODEL_1_NAME="openai/gpt-4o-mini"
MODEL_1_TEMPERATURE=0.0

# Model 2 (Evaluator & Ambiguity Arbiter, T=0.2)
# OpenRouter format: provider/model-name (e.g. openai/gpt-4o, anthropic/claude-3.5-sonnet, google/gemini-pro-1.5)
MODEL_2_NAME="openai/gpt-4o"
MODEL_2_TEMPERATURE=0.2

# Deterministic Gating Thresholds
CONFIDENCE_DIRECT_THRESHOLD=0.85
CONFIDENCE_REJECTION_THRESHOLD=0.40

# Supabase Managed PostgreSQL Configuration
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=""
